# Optional local settings. Copy to .env if you want to change anything (never commit .env).

# Where the SQLite database lives (default: instance/trainer.db)
# BIGO_DB=/path/to/trainer.db

# Port for `python app.py` (default 5000)
# PORT=5000

# Seconds a pseudocode submission may run before it's stopped (default 10)
# SANDBOX_TIMEOUT=10
